APP_NAME=midocss-platform
APP_ENV=development
APP_DEBUG=true
APP_DEFAULT_LANG=ar
APP_BASE_URL=http://localhost:8080

HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_ALLOWED_ORIGINS=http://localhost:3000
# HTTP_TRUSTED_PROXIES=10.0.0.0/8

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=midocss
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=1h

# Must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_ISSUER=midocss-platform
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
MINIO_PUBLIC_BUCKET=public
MINIO_PRIVATE_BUCKET=private
MINIO_SIGNED_URL_EXPIRY=15m

ZAINCASH_MERCHANT_ID=
ZAINCASH_MSISDN=
ZAINCASH_SECRET=
ZAINCASH_BASE_URL=https://test.zaincash.iq
ZAINCASH_SUCCESS_URL=http://localhost:3000/checkout/success
ZAINCASH_FAILURE_URL=http://localhost:3000/checkout/failed

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Super Admin
